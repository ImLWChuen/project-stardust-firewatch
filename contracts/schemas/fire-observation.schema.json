{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FireObservation",
  "description": "Canonical representation of a single satellite active fire detection point.",
  "type": "object",
  "required": [
    "latitude",
    "longitude",
    "acq_date",
    "acq_time",
    "satellite",
    "instrument",
    "frp"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0
    },
    "acq_date": {
      "type": "string",
      "format": "date"
    },
    "acq_time": {
      "type": "string",
      "pattern": "^[0-2][0-9][0-5][0-9]$"
    },
    "satellite": {
      "type": "string",
      "enum": [
        "Terra",
        "Aqua",
        "Suomi-NPP",
        "NOAA-20",
        "NOAA-21"
      ]
    },
    "instrument": {
      "type": "string",
      "enum": [
        "MODIS",
        "VIIRS"
      ]
    },
    "confidence": {
      "type": [
        "string",
        "number"
      ]
    },
    "brightness": {
      "type": "number"
    },
    "bright_t31": {
      "type": [
        "number",
        "null"
      ]
    },
    "bright_ti4": {
      "type": [
        "number",
        "null"
      ]
    },
    "bright_ti5": {
      "type": [
        "number",
        "null"
      ]
    },
    "scan": {
      "type": "number"
    },
    "track": {
      "type": "number"
    },
    "frp": {
      "type": "number",
      "minimum": 0.0
    },
    "daynight": {
      "type": "string",
      "enum": [
        "D",
        "N"
      ]
    }
  }
}
