{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FireCellDay",
  "description": "Daily aggregated fire observations over a discrete spatial grid cell.",
  "type": "object",
  "required": [
    "cell_id",
    "date",
    "cell_lat",
    "cell_lon",
    "raw_count",
    "raw_frp_sum"
  ],
  "properties": {
    "cell_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cell_lat": {
      "type": "number"
    },
    "cell_lon": {
      "type": "number"
    },
    "grid_size_deg": {
      "type": "number",
      "default": 0.01
    },
    "raw_count": {
      "type": "integer",
      "minimum": 0
    },
    "raw_frp_sum": {
      "type": "number",
      "minimum": 0.0
    },
    "raw_frp_mean": {
      "type": "number",
      "minimum": 0.0
    },
    "modis_count": {
      "type": "integer",
      "minimum": 0
    },
    "viirs_count": {
      "type": "integer",
      "minimum": 0
    },
    "sensors_present": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
