{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AreaOfInterest",
  "description": "Geographical Area of Interest (AOI) boundary definition and metadata.",
  "type": "object",
  "required": [
    "id",
    "name",
    "country",
    "bbox",
    "geometry"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "agricultural",
        "forestry",
        "peatland",
        "mixed"
      ]
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "[min_lon, min_lat, max_lon, max_lat]"
    },
    "geometry": {
      "type": "object"
    }
  }
}
