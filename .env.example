# FIRMS API Configuration
FIRMS_MAP_KEY=your_firms_map_key_here
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api

# Backend Configuration
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=stardust_super_secret_development_key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / PostGIS)
DATABASE_URL=postgresql://stardust:stardust_password@localhost:5432/stardust_db
REDIS_URL=redis://localhost:6379/0

# Data Pipeline Paths
DATA_RAW_DIR=./data/raw
DATA_INTERIM_DIR=./data/interim
DATA_PROCESSED_DIR=./data/processed

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_if_needed
